{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "start": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "end": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "description": "IANA 時區，例如 Asia/Tokyo"
    },
    "info": {
      "description": "旅程總覽：航班、住宿、票券等",
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "days": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "description": "用於 #day-N"
          },
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "note": {
            "description": "Markdown；可寫成字串陣列，每個元素一行",
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "stops": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]*$",
                  "description": "同一天內唯一"
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "ll": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number",
                      "minimum": -90,
                      "maximum": 90
                    },
                    {
                      "type": "number",
                      "minimum": -180,
                      "maximum": 180
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2,
                  "description": "[緯度, 經度]"
                },
                "placeId": {
                  "description": "Google Place ID",
                  "type": "string",
                  "minLength": 1
                },
                "time": {
                  "description": "自由文字，例如「13:20–14:40」或「上午」",
                  "type": "string",
                  "minLength": 1
                },
                "note": {
                  "description": "Markdown；可寫成字串陣列，每個元素一行",
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  ]
                },
                "photos": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "src": {
                        "type": "string",
                        "format": "uri",
                        "description": "原圖網址"
                      },
                      "thumb": {
                        "description": "縮圖網址；未填時用 src",
                        "type": "string",
                        "format": "uri"
                      },
                      "caption": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": ["src"],
                    "additionalProperties": false
                  }
                },
                "optional": {
                  "description": "可選行程",
                  "type": "boolean"
                }
              },
              "required": ["id", "name", "ll"],
              "additionalProperties": false
            }
          },
          "legs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string",
                  "minLength": 1,
                  "description": "起點 stop id"
                },
                "to": {
                  "type": "string",
                  "minLength": 1,
                  "description": "終點 stop id，可以等於 from"
                },
                "mode": {
                  "type": "string",
                  "enum": ["rail", "subway", "bus", "boat", "walk", "taxi", "flight", "open"]
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "time": {
                  "type": "string",
                  "minLength": 1
                },
                "note": {
                  "description": "Markdown；可寫成字串陣列，每個元素一行",
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  ]
                },
                "path": {
                  "description": "未填時兩點直線",
                  "minItems": 2,
                  "type": "array",
                  "items": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number",
                        "minimum": -90,
                        "maximum": 90
                      },
                      {
                        "type": "number",
                        "minimum": -180,
                        "maximum": 180
                      }
                    ],
                    "items": false,
                    "minItems": 2,
                    "maxItems": 2,
                    "description": "[緯度, 經度]"
                  }
                },
                "optional": {
                  "type": "boolean"
                }
              },
              "required": ["from", "to", "mode"],
              "additionalProperties": false
            }
          },
          "groups": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "stops": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": ["name", "stops"],
              "additionalProperties": false
            }
          }
        },
        "required": ["id", "date", "title", "stops"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schemaVersion", "slug", "title", "start", "end", "timezone", "days"],
  "additionalProperties": false
}
