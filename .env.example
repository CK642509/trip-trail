# 複製成 .env 後填入。.env 不會提交到 git。
# 正式環境的值設在 Vercel 專案的 Environment Variables。

# Google Maps JavaScript API（會出現在前端，請在 Cloud Console 限制 HTTP referrer）
VITE_GOOGLE_MAPS_API_KEY=
# 地圖管理 → 建立 Map ID（JavaScript、Vector）；開發時可先用 DEMO_MAP_ID
VITE_GOOGLE_MAP_ID=DEMO_MAP_ID

# 每趟旅程的密碼 hash（值不是密碼原文，用下面的指令產生）
# TRIP_KANSAI_2026_HASH=   ← npm run hash-password -- kansai-2026 <密碼>

# 照片上傳（只有本機的 npm run photos 會用到，不用加到 Vercel）
# Cloudflare R2 → Manage API tokens → 權限 Object Read & Write、只限這個 bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=trip-trail-photos
# bucket 的 Public Development URL（https://pub-….r2.dev）
R2_PUBLIC_URL=
